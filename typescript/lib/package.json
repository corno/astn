{
  "name": "astn",
  "version": "0.113.113",
  "author": "Corno",
  "license": "Apache-2.0",
  "description": "The TypeScript library for parsing and formatting ASTN (Abstract Syntax Tree Notation) - a human-editable data format for structured content",
  "keywords": [
    "astn",
    "parser",
    "formatter",
    "abstract-syntax-tree",
    "data-format",
    "typescript",
    "lexer",
    "structured-data",
    "configuration",
    "serialization"
  ],
  "bugs": {
    "url": "https://github.com/corno/astn/issues"
  },
  "homepage": "https://github.com/corno/astn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corno/astn.git"
  },
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "documentation"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "astn-runtime": "^0.1.0",
    "liana-runtime": "^0.1.0",
    "pareto-application-api": "^0.1.0",
    "pareto-common": "^0.1.0",
    "pareto-core": "^0.1.0",
    "pareto-filesystem-unrestricted-api": "^0.1.0",
    "pareto-fountain-pen": "^0.4.0",
    "pareto-json": "^0.3.0",
    "pareto-stream-api": "^0.1.0"
  }
}
